# Supabase (remote)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Local Supabase (run `supabase start`, then `supabase status` for keys) ---
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon-key-from-supabase-status>
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key-from-supabase-status>

# SMTP (e.g. AWS SES)
SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Fluitplanner <noreply@yourdomain.com>

# Site URL (used for magic links and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base domain for multi-tenancy (subdomains resolve to tenant slugs)
NEXT_PUBLIC_BASE_DOMAIN=fluiten.org

# The single origin WebAuthn ceremonies run on. Must be your deployment's
# CANONICAL origin — if the host redirects the apex to www (or the reverse),
# naming the wrong one makes the passkey page redirect in a loop. Must also
# match the Relying Party Origins entry in the Supabase dashboard exactly.
# Defaults to https://<NEXT_PUBLIC_BASE_DOMAIN>. Leave unset locally.
NEXT_PUBLIC_PASSKEY_ORIGIN=https://www.fluiten.org

# Vercel cron authentication (Vercel sends it as a Bearer token to cron routes)
CRON_SECRET=your-cron-secret

# E2E tests (optional — only needed for Playwright tests)
E2E_TEST_EMAIL=your-test-account@example.com
E2E_TEST_PASSWORD=your-test-password
